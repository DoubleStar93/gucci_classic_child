# Copia in .env e compila con i dati Hostinger (File Manager → FTP Accounts)

FTP_HOST=46.202.158.43
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false

# L'account FTP punta già alla root PrestaShop (public_html)
FTP_REMOTE_PATH=/themes/classic-gucci

# Cache da svuotare a ogni deploy (cartelle intere, separate da virgola)
# /var/cache = Symfony (prod, dev, …)
# /cache     = cache PrestaShop in root (smarty, immagini, …)
FTP_CACHE_PATHS=/var/cache,/cache

# Copia in .env e compila con i dati SiteGround (Site Tools → FTP Accounts)

FTP_HOST=gnldm1110.siteground.biz
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false

# SiteGround: root FTP = / → sito in /barbaraalvisi.it/public_html/
FTP_REMOTE_PATH=/barbaraalvisi.it/public_html/themes/barbaraalvisi
# Cache da invalidare a ogni deploy (separate da virgola)
# SiteGround es.: /barbaraalvisi.it/public_html/var/cache
FTP_CACHE_PATHS=/barbaraalvisi.it/public_html/var/cache

# stash = rinomina in _stash-* + cartella vuota (veloce, default)
# delete = elimina ricorsivamente (lento, pulizia totale)
FTP_CACHE_MODE=stash

# stash = rinomina tema + upload completo (veloce, niente file orphan)
# sync  = solo file nuovi/modificati (più veloce, può lasciare orphan)
# delete = elimina tema ricorsivamente + upload completo (lento)
FTP_THEME_MODE=stash

# URL da mostrare a fine deploy (opzionale)
STAGING_URL=https://barbaraalvisi.it/

# Moduli custom da sincronizzare con deploy (oltre al tema)
FTP_DEPLOY_MODULES=everpspopup,barbaraalvisi_homecategories

{**
 * Classic Gucci — account icon + drawer
 *}
<div id="_desktop_user_info" class="gucci-account">
  <div class="user-info">
    <button
      type="button"
      id="gucci-account-toggle"
      class="gucci-account-toggle btn-unstyle"
      aria-label="{if $logged}{l s='My account' d='Shop.Theme.Customeraccount'}{else}{l s='Sign in' d='Shop.Theme.Actions'}{/if}"
      aria-expanded="false"
      aria-controls="gucci-account-drawer"
    >
      <i class="material-icons" aria-hidden="true">person_outline</i>
    </button>
  </div>
</div>

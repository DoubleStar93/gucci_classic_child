{
  "parent": "classic",
  "name": "barbaraalvisi",
  "display_name": "Barbara Alvisi",
  "version": "1.8.2",
  "author": {
    "name": "Antonio Angora",
    "email": "",
    "url": ""
  },
  "meta": {
    "compatibility": {
      "from": "9.0.0",
      "to": null
    },
    "framework": "bootstrap-v4.0.0-alpha.5",
    "available_layouts": {
      "layout-full-width": {
        "name": "Full Width",
        "description": "No side columns, ideal for distraction-free pages such as product pages."
      },
      "layout-both-columns": {
        "name": "Three Columns",
        "description": "One large central column and 2 side columns."
      },
      "layout-left-column": {
        "name": "Two Columns, small left column",
        "description": "Two columns with a small left column"
      },
      "layout-right-column": {
        "name": "Two Columns, small right column",
        "description": "Two columns with a small right column"
      }
    }
  },
  "assets": {
    "use_parent_assets": true
  },
  "global_settings": {
    "hooks": {
      "modules_to_hook": {
        "displayNav1": [],
        "displayTop": [
          "ps_mainmenu"
        ],
        "displayNav2": [
          "ps_shoppingcart",
          "ps_customersignin"
        ],
        "displayHome": [
          "ps_imageslider",
          "ps_featuredproducts",
          "barbaraalvisi_homecategories",
          "ps_customtext",
          "ps_specials",
          "ps_newproducts",
          "ps_bestsellers"
        ],
        "displayCrossSellingShoppingCart": [
          "ps_featuredproducts"
        ],
        "displayOrderConfirmation2": [
          "ps_featuredproducts"
        ],
        "displayCartModalFooter": [
          "ps_featuredproducts"
        ],
        "displayNotFound": [
          "ps_featuredproducts"
        ],
        "displayFooterProduct": [
          "ps_categoryproducts"
        ],
        "displayFooterBefore": [],
        "displayFooter": [
          "ps_linklist"
        ],
        "displayFooterAfter": [
          "ps_languageselector",
          "ps_socialfollow"
        ],
        "displayLeftColumn": [],
        "displayReassurance": [],
        "displayWrapperTop": [],
        "displayWrapperBottom": []
      }
    },
    "image_types": {
      "cart_default": {
        "width": 125,
        "height": 125,
        "scope": [
          "products"
        ]
      },
      "small_default": {
        "width": 98,
        "height": 98,
        "scope": [
          "products",
          "categories",
          "manufacturers",
          "suppliers"
        ]
      },
      "medium_default": {
        "width": 452,
        "height": 452,
        "scope": [
          "products",
          "manufacturers",
          "suppliers"
        ]
      },
      "home_default": {
        "width": 250,
        "height": 250,
        "scope": [
          "products"
        ]
      },
      "large_default": {
        "width": 800,
        "height": 800,
        "scope": [
          "products",
          "manufacturers",
          "suppliers"
        ]
      },
      "category_default": {
        "width": 141,
        "height": 180,
        "scope": [
          "categories"
        ]
      },
      "stores_default": {
        "width": 170,
        "height": 115,
        "scope": [
          "stores"
        ]
      }
    }
  },
  "theme_settings": {
    "default_layout": "layout-full-width",
    "layouts": {
      "category": "layout-full-width",
      "best-sales": "layout-full-width",
      "new-products": "layout-full-width",
      "prices-drop": "layout-full-width",
      "manufacturer": "layout-full-width",
      "supplier": "layout-full-width",
      "contact": "layout-full-width",
      "search": "layout-full-width",
      "cart": "layout-full-width",
      "checkout": "layout-full-width",
      "authentication": "layout-full-width",
      "registration": "layout-full-width",
      "my-account": "layout-full-width",
      "cms": "layout-full-width",
      "order-confirmation": "layout-full-width",
      "stores": "layout-full-width",
      "history": "layout-full-width",
      "order-detail": "layout-full-width",
      "password": "layout-full-width",
      "address": "layout-full-width",
      "guest-tracking": "layout-full-width",
      "guest-login": "layout-full-width",
      "discount": "layout-full-width",
      "order-slip": "layout-full-width",
      "order-follow": "layout-full-width",
      "page-not-found": "layout-full-width",
      "sitemap": "layout-full-width"
    }
  }
}